# Cloudflare API token (never a Global API Key). Create it at
# dash.cloudflare.com > My Profile > API Tokens > Create Token > Custom token.
# Read-only and write tokens need different permissions: see README.md,
# "API token permissions".
CLOUDFLARE_API_TOKEN=

# Log level (stderr): debug, info, warn, error. Tool arguments and the
# token are never logged.
LOG_LEVEL=info
