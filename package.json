{
  "name": "@cititec-pty-ltd/cloudflare-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Cloudflare API: zones, DNS records, settings, SSL, cache purge, with one named tool per action",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "cloudflare-mcp": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cititec-Pty-Ltd/cloudflare-mcp"
  },
  "scripts": {
    "build": "tsup",
    "prebuild": "npm run clean",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "cloudflare",
    "dns",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Cititec Pty Ltd",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.0.0",
    "@types/node": "^22.10.0",
    "semantic-release": "^25.0.9",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "zod": "4.3.6"
  }
}
